<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="13122.16" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="TAB-ROOT">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="13104.12"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Tab Bar Controller-->
        <scene sceneID="SCENE-TAB">
            <objects>
                <tabBarController id="TAB-ROOT" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="TAB-BAR">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                    </tabBar>
                    <connections>
                        <segue destination="NAV-TODAY" kind="relationship" relationship="viewControllers" id="SEG-TODAY"/>
                        <segue destination="NAV-FORECAST" kind="relationship" relationship="viewControllers" id="SEG-FORECAST"/>
                        <segue destination="NAV-FAVORITES" kind="relationship" relationship="viewControllers" id="SEG-FAVORITES"/>
                        <segue destination="NAV-SETTINGS" kind="relationship" relationship="viewControllers" id="SEG-SETTINGS"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-TAB" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Today Navigation Controller-->
        <scene sceneID="SCENE-NAV-TODAY">
            <objects>
                <navigationController id="NAV-TODAY" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Today" id="TBI-TODAY"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="NB-TODAY">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="VC-TODAY" kind="relationship" relationship="rootViewController" id="ROOT-TODAY"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-NAV-TODAY" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Forecast Navigation Controller-->
        <scene sceneID="SCENE-NAV-FORECAST">
            <objects>
                <navigationController id="NAV-FORECAST" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Forecast" id="TBI-FORECAST"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="NB-FORECAST">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="VC-FORECAST" kind="relationship" relationship="rootViewController" id="ROOT-FORECAST"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-NAV-FORECAST" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Favorites Navigation Controller-->
        <scene sceneID="SCENE-NAV-FAVORITES">
            <objects>
                <navigationController id="NAV-FAVORITES" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Favorites" id="TBI-FAVORITES"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="NB-FAVORITES">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="VC-FAVORITES" kind="relationship" relationship="rootViewController" id="ROOT-FAVORITES"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-NAV-FAVORITES" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Settings Navigation Controller-->
        <scene sceneID="SCENE-NAV-SETTINGS">
            <objects>
                <navigationController id="NAV-SETTINGS" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Settings" id="TBI-SETTINGS"/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="NB-SETTINGS">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="44"/>
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="VC-SETTINGS" kind="relationship" relationship="rootViewController" id="ROOT-SETTINGS"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-NAV-SETTINGS" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Today View Controller-->
        <scene sceneID="SCENE-VC-TODAY">
            <objects>
                <viewController id="VC-TODAY" customClass="TodayViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="VIEW-TODAY">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                        <viewLayoutGuide key="safeArea" id="SAFE-TODAY"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-VC-TODAY" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Forecast View Controller-->
        <scene sceneID="SCENE-VC-FORECAST">
            <objects>
                <tableViewController id="VC-FORECAST" customClass="ForecastViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <tableView key="tableView" clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="prototypes" style="plain" separatorStyle="singleLine" rowHeight="60" estimatedRowHeight="60" id="TV-FORECAST">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                        <prototypes>
                            <tableViewCell contentMode="scaleToFill" selectionStyle="default" indentationWidth="10" reuseIdentifier="CityCell" id="CELL-CITY" customClass="CityTableViewCell" customModuleProvider="target">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="60"/>
                                <tableViewCellContentView key="contentView" opaque="NO" contentMode="scaleToFill" id="CELL-CONTENT">
                                    <rect key="frame" x="0.0" y="0.0" width="375" height="60"/>
                                    <autoresizingMask key="autoresizingMask"/>
                                    <subviews>
                                        <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="2" translatesAutoresizingMaskIntoConstraints="NO" id="SV-CITY">
                                            <rect key="frame" x="16" y="10" width="343" height="40"/>
                                            <subviews>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="City" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-TITLE">
                                                    <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                    <color key="textColor" xcode11CocoaTouchSystemColor="labelColor" cocoaTouchSystemColor="darkTextColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Region, Country" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-SUBTITLE">
                                                    <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                                    <color key="textColor" xcode11CocoaTouchSystemColor="secondaryLabelColor" cocoaTouchSystemColor="darkTextColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                            </subviews>
                                        </stackView>
                                    </subviews>
                                    <constraints>
                                        <constraint firstItem="SV-CITY" firstAttribute="leading" secondItem="CELL-CONTENT" secondAttribute="leading" constant="16" id="CST-L"/>
                                        <constraint firstAttribute="trailing" secondItem="SV-CITY" secondAttribute="trailing" constant="16" id="CST-R"/>
                                        <constraint firstItem="SV-CITY" firstAttribute="top" secondItem="CELL-CONTENT" secondAttribute="top" constant="10" id="CST-T"/>
                                        <constraint firstAttribute="bottom" secondItem="SV-CITY" secondAttribute="bottom" constant="10" id="CST-B"/>
                                    </constraints>
                                </tableViewCellContentView>
                                <connections>
                                    <segue destination="VC-CITY-DETAILS" kind="show" identifier="ShowCityDetails" id="SEG-SHOW-DETAILS"/>
                                    <outlet property="titleLabel" destination="LBL-TITLE" id="OUT-TITLE"/>
                                    <outlet property="subtitleLabel" destination="LBL-SUBTITLE" id="OUT-SUBTITLE"/>
                                </connections>
                            </tableViewCell>
                        </prototypes>
                    </tableView>
                </tableViewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-VC-FORECAST" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--City Details View Controller-->
        <scene sceneID="SCENE-VC-CITY-DETAILS">
            <objects>
                <viewController id="VC-CITY-DETAILS" customClass="CityDetailsViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="VIEW-CITY-DETAILS">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="SV-SCROLL">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="SV-ROOT">
                                        <rect key="frame" x="16" y="16" width="343" height="483"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="City" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-CITY-TITLE">
                                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="28"/>
                                                <color key="textColor" xcode11CocoaTouchSystemColor="labelColor" cocoaTouchSystemColor="darkTextColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Region, Country" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontForContentSizeCategory="YES" translatesAutoresizingMaskIntoConstraints="NO" id="LBL-CITY-SUBTITLE">
                                                <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                <color key="textColor" xcode11CocoaTouchSystemColor="secondaryLabelColor" cocoaTouchSystemColor="darkTextColor"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                            <imageView clipsSubviews="YES" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="IMG-ICON">
                                                <rect key="frame" x="0.0" y="79" width="343" height="120"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="120" id="IMG-H"/>
                                                </constraints>
                                            </imageView>
                                            <textField opaque="NO" contentMode="scaleToFill" placeholder="Custom title" textAlignment="natural" borderStyle="roundedRect" translatesAutoresizingMaskIntoConstraints="NO" id="TF-TITLE">
                                                <rect key="frame" x="0.0" y="211" width="343" height="34"/>
                                            </textField>
                                            <textView clipsSubviews="YES" contentMode="scaleToFill" textAlignment="natural" translatesAutoresizingMaskIntoConstraints="NO" id="TV-NOTE">
                                                <rect key="frame" x="0.0" y="257" width="343" height="120"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="120" id="TV-H"/>
                                                </constraints>
                                                <string key="text">Note</string>
                                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                                            </textView>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" configuration="filled" translatesAutoresizingMaskIntoConstraints="NO" id="BTN-FAV">
                                                <rect key="frame" x="0.0" y="389" width="343" height="44"/>
                                                <state key="normal" title="Add to Favorites"/>
                                                <connections>
                                                    <action selector="favoriteTapped:" destination="VC-CITY-DETAILS" eventType="touchUpInside" id="ACT-FAV"/>
                                                </connections>
                                            </button>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" configuration="tinted" translatesAutoresizingMaskIntoConstraints="NO" id="BTN-SAVE">
                                                <rect key="frame" x="0.0" y="445" width="343" height="38"/>
                                                <state key="normal" title="Save"/>
                                                <connections>
                                                    <action selector="saveTapped:" destination="VC-CITY-DETAILS" eventType="touchUpInside" id="ACT-SAVE"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="SV-ROOT" firstAttribute="leading" secondItem="SV-SCROLL" secondAttribute="leading" constant="16" id="SCR-L"/>
                                    <constraint firstAttribute="trailing" secondItem="SV-ROOT" secondAttribute="trailing" constant="16" id="SCR-R"/>
                                    <constraint firstItem="SV-ROOT" firstAttribute="top" secondItem="SV-SCROLL" secondAttribute="top" constant="16" id="SCR-T"/>
                                    <constraint firstAttribute="bottom" secondItem="SV-ROOT" secondAttribute="bottom" constant="16" id="SCR-B"/>
                                    <constraint firstItem="SV-ROOT" firstAttribute="width" secondItem="SV-SCROLL" secondAttribute="width" constant="-32" id="SCR-W"/>
                                </constraints>
                            </scrollView>
                        </subviews>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                        <constraints>
                            <constraint firstItem="SV-SCROLL" firstAttribute="leading" secondItem="VIEW-CITY-DETAILS" secondAttribute="leading" id="ROOT-L"/>
                            <constraint firstAttribute="trailing" secondItem="SV-SCROLL" secondAttribute="trailing" id="ROOT-R"/>
                            <constraint firstItem="SV-SCROLL" firstAttribute="top" secondItem="VIEW-CITY-DETAILS" secondAttribute="top" id="ROOT-T"/>
                            <constraint firstAttribute="bottom" secondItem="SV-SCROLL" secondAttribute="bottom" id="ROOT-B"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="SAFE-CITY-DETAILS"/>
                    </view>
                    <connections>
                        <outlet property="cityTitleLabel" destination="LBL-CITY-TITLE" id="OUT-CITY-TITLE"/>
                        <outlet property="subtitleLabel" destination="LBL-CITY-SUBTITLE" id="OUT-CITY-SUBTITLE"/>
                        <outlet property="iconImageView" destination="IMG-ICON" id="OUT-ICON"/>
                        <outlet property="titleTextField" destination="TF-TITLE" id="OUT-TF"/>
                        <outlet property="noteTextView" destination="TV-NOTE" id="OUT-TV"/>
                        <outlet property="favoriteButton" destination="BTN-FAV" id="OUT-FAV"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-VC-CITY-DETAILS" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Favorites View Controller-->
        <scene sceneID="SCENE-VC-FAVORITES">
            <objects>
                <viewController id="VC-FAVORITES" customClass="FavoritesViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="VIEW-FAVORITES">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                        <viewLayoutGuide key="safeArea" id="SAFE-FAVORITES"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-VC-FAVORITES" sceneMemberID="firstResponder"/>
            </objects>
        </scene>

        <!--Settings View Controller-->
        <scene sceneID="SCENE-VC-SETTINGS">
            <objects>
                <viewController id="VC-SETTINGS" customClass="SettingsViewController" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="VIEW-SETTINGS">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <color key="backgroundColor" xcode11CocoaTouchSystemColor="systemBackgroundColor" cocoaTouchSystemColor="whiteColor"/>
                        <viewLayoutGuide key="safeArea" id="SAFE-SETTINGS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="FR-VC-SETTINGS" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
</document>
